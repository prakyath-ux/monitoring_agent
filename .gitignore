# Environment variables (API keys)
.env
.env.local
.env.*.local
.claude/
# Virtual environment
venv/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Agent logs (can contain sensitive code)
.agent/logs/
.agent/scan.json
.agent/reports/
.agent/usage/

# Agent runtime files (must not be tracked or checkout will break pause/pid)
.agent/.pid
.agent/.paused

# OS files
.DS_Store
*.pdf
*.mov

# IDE
.vscode/
.idea/

# Extension build artifacts
version2/extension/node_modules/
version2/extension/package-lock.json

# SonarQube rule data (fetched locally, not tracked)
sonar_rules/
version2/jetbrains-plugin/
